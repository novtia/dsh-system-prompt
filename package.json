{
  "name": "dsh-system-prompt",
  "description": "Settings page that overlays the deployment identity fragment of the system prompt",
  "version": "0.1.0",
  "type": "module",
  "main": "lib/index.js",
  "types": "lib/types/index.d.ts",
  "license": "MIT",
  "author": "novtia",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/novtia/dsh-system-prompt.git"
  },
  "homepage": "https://github.com/novtia/dsh-system-prompt#readme",
  "bugs": {
    "url": "https://github.com/novtia/dsh-system-prompt/issues"
  },
  "keywords": [
    "dsh-plugin",
    "deepseek-harness",
    "dsh",
    "system-prompt",
    "persona"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json && tsdown --config-loader tsx",
    "prepack": "npm run build"
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": "^4.0.1",
    "@deepseek-ai/dsh-settings": "^0.1.0-rc.7 || ^0.1.1-rc.2 || ^0.1.2-alpha.2",
    "@deepseek-ai/schemastery": "^3.18.1"
  },
  "peerDependenciesMeta": {
    "@deepseek-ai/dsh-settings": {
      "optional": true
    },
    "@deepseek-ai/schemastery": {
      "optional": true
    }
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "inject": [
        "@deepseek-ai/dsh-client-locale",
        "@deepseek-ai/dsh-client-ui-settings"
      ],
      "platform": "web"
    }
  },
  "exports": {
    ".": {
      "types": "./lib/types/index.d.ts",
      "default": "./lib/index.js"
    },
    "./client": "./client/client.js",
    "./cordis.patch.yml": "./cordis.patch.yml",
    "./package.json": "./package.json"
  },
  "files": [
    "lib/index.js",
    "lib/types/index.d.ts",
    "client/client.js",
    "cordis.patch.yml",
    "LICENSE"
  ],
  "devDependencies": {
    "@deepseek-ai/cordis": "^4.0.2",
    "@deepseek-ai/schemastery": "^3.18.2",
    "@types/react": "~18.3.1",
    "lightningcss": "^1.30.1",
    "react": "^18.3.1",
    "tsdown": "^0.22.2",
    "tsx": "^4.20.5",
    "typescript": "^5.9.2"
  }
}
